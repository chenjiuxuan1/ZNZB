  "alerts": {
    "channel": "tv",
    "webhookUrl": "${TV_ALERT_WEBHOOK_URL}",
    "botId": "${TV_ALERT_BOT_ID}",
    "textField": "message",
    "sendWhenHealthy": true,
    "maxAnomalies": 50
  },
  "usage": {
    "enabled": true,
    "source": "gateway",
    "days": 30,
    "gateway": {
      "webhookUrl": "${DS_USAGE_WEBHOOK_URL}",
      "action": "usage_report"
    },
    "ssh": {
      "command": "ssh",
      "host": "10.20.47.14",
      "port": 36000,
      "user": "root",
      "identityFile": "",
      "options": [
        "StrictHostKeyChecking=no",
        "ConnectTimeout=10"
      ]
    },
    "auditDb": {
      "host": "10.20.47.19",
      "port": 3306,
      "user": "root",
      "password": "${DS_AUDIT_DB_PASSWORD}",
      "database": "warning_rule",
      "table": "ds_operation_audit_log"
    },
    "tokenMap": {
      "enabled": true,
      "sql": "SELECT u.user_name, a.token FROM t_ds_access_token a JOIN t_ds_user u ON u.id = a.user_id WHERE a.token IS NOT NULL AND a.token <> ''",
      "ssh": {
        "command": "ssh",
        "options": [
          "StrictHostKeyChecking=no",
          "ConnectTimeout=15"
        ]
      },
      "countries": {
        "CN": {
          "name": "中国",
