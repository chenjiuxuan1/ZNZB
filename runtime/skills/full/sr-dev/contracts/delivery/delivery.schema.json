{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warehouse-agent.local/contracts/delivery/delivery.schema.json",
  "title": "Warehouse Agent Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "summary",
    "conclusions",
    "evidence",
    "limitations",
    "provenance"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "summary": {
      "type": "string"
    },
    "conclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_tier",
        "confidence",
        "review_status",
        "country",
        "datasource",
        "freshness",
        "owner",
        "critical_filters",
        "canonical_table",
        "trace_id"
      ],
      "properties": {
        "source_tier": {
          "type": "string",
          "enum": ["semantic", "governed_ref", "raw_exploration"]
        },
        "source_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sql_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": ["uncertain", "low", "medium", "high"]
        },
        "review_status": {
          "type": "string",
          "enum": ["auto_reviewed", "human_reviewed", "blocked"]
        },
        "country": {
          "type": "string"
        },
        "datasource": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "critical_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canonical_table": {
          "type": "string"
        },
        "trace_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
