{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warehouse-agent.local/contracts/semantic/semantic-entity.schema.json",
  "title": "Warehouse Agent Semantic Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "description",
    "owner",
    "freshness",
    "source",
    "canonical_assets",
    "filters",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "kind": {
      "type": "string",
      "enum": ["metric", "dimension", "segment"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "team"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_schedule", "max_age_hours", "verified_at"],
      "properties": {
        "expected_schedule": {
          "type": "string",
          "minLength": 1
        },
        "max_age_hours": {
          "type": "integer",
          "minimum": 1
        },
        "verified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "uri"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["semantic", "governed_ref"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canonical_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expression"],
        "properties": {
          "name": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "verified", "deprecated"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
