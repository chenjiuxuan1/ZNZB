{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warehouse-agent.local/contracts/task/state.schema.json",
  "title": "Warehouse Agent Task State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "status",
    "current_phase",
    "current_skill",
    "risk_level",
    "source_tier",
    "confidence",
    "requires_sr_execution",
    "requires_human_approval",
    "context_loaded",
    "pending_decisions",
    "completed_steps",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "needs_clarification",
        "planning",
        "ready_for_execution",
        "executing",
        "reviewing",
        "ready_for_delivery",
        "blocked",
        "closed"
      ]
    },
    "current_phase": {
      "type": "string",
      "minLength": 1
    },
    "current_skill": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": ["unknown", "low", "medium", "high", "critical"]
    },
    "source_tier": {
      "type": "string",
      "enum": ["unknown", "semantic", "governed_ref", "raw_exploration"]
    },
    "confidence": {
      "type": "string",
      "enum": ["uncertain", "low", "medium", "high"]
    },
    "requires_sr_execution": {
      "type": "boolean"
    },
    "requires_human_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "jira_comment",
          "pdf",
          "report",
          "group_message",
          "email",
          "ds_change",
          "production_ddl_dml"
        ]
      },
      "uniqueItems": true
    },
    "context_loaded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "pending_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "next_action": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
