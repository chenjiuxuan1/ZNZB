{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warehouse-agent.local/semantic-layer/manifest.schema.json",
  "title": "Warehouse Semantic Layer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "author",
    "shared_contract",
    "retrieval",
    "entities"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated"]
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "shared_contract": {
      "const": "contracts/semantic/semantic-entity.schema.json"
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "normalization"],
      "properties": {
        "order": {
          "type": "array",
          "prefixItems": [
            {"const": "exact_id"},
            {"const": "normalized_exact_name_or_alias"},
            {"const": "business_domain_filter"},
            {"const": "semantic_miss_or_ambiguity"}
          ],
          "items": false
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lowercase",
            "trim_whitespace",
            "separator_equivalence"
          ],
          "properties": {
            "lowercase": {"const": true},
            "trim_whitespace": {"const": true},
            "separator_equivalence": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "path",
          "display_name",
          "aliases"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["metric", "dimension", "segment"]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(metrics/[a-z0-9_-]+/[a-z0-9_-]+|dimensions/[a-z0-9_-]+|segments/[a-z0-9_-]+)\\.yaml$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "business_domain": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"kind": {"const": "metric"}},
              "required": ["kind"]
            },
            "then": {"required": ["business_domain"]}
          }
        ]
      }
    }
  }
}
