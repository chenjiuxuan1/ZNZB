{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warehouse-agent.local/semantic-layer/metric.schema.json",
  "title": "Warehouse Semantic Metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "aliases",
    "description",
    "business_domain",
    "owner",
    "status",
    "freshness",
    "source",
    "canonical_assets",
    "filters",
    "validation",
    "query_spec",
    "dimensions",
    "segments",
    "limitations",
    "known_pitfalls"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.[a-z0-9_-]+$"
    },
    "kind": {"const": "metric"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "description": {"type": "string", "minLength": 1},
    "business_domain": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "owner": {"$ref": "#/$defs/owner"},
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "freshness": {"$ref": "#/$defs/sharedFreshness"},
    "source": {"$ref": "#/$defs/source"},
    "canonical_assets": {"$ref": "#/$defs/canonicalAssets"},
    "filters": {"$ref": "#/$defs/filters"},
    "validation": {"$ref": "#/$defs/validation"},
    "query_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_country",
        "datasource_hint",
        "canonical_table",
        "metric_expression",
        "default_time_field",
        "default_granularity",
        "default_filters",
        "freshness",
        "unit",
        "required_parameters"
      ],
      "properties": {
        "default_country": {
          "type": "string",
          "enum": ["cn", "th", "mx", "ph", "pk", "id", "unknown"]
        },
        "datasource_hint": {"type": "string", "minLength": 1},
        "canonical_table": {
          "type": "string",
          "pattern": "^(unknown|[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*)$"
        },
        "metric_expression": {"type": "string", "minLength": 1},
        "default_time_field": {"type": "string", "minLength": 1},
        "default_granularity": {"type": "string", "minLength": 1},
        "default_filters": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "partition_field",
            "expected_lag",
            "verification_required"
          ],
          "properties": {
            "partition_field": {"type": "string", "minLength": 1},
            "expected_lag": {"type": "string", "minLength": 1},
            "verification_required": {"const": true}
          }
        },
        "unit": {
          "type": "string",
          "enum": [
            "percentage",
            "currency",
            "count",
            "ratio",
            "seconds",
            "other"
          ]
        },
        "required_parameters": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "segments": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "known_pitfalls": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "team"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "team": {"type": "string", "minLength": 1}
      }
    },
    "sharedFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_schedule", "max_age_hours", "verified_at"],
      "properties": {
        "expected_schedule": {"type": "string", "minLength": 1},
        "max_age_hours": {"type": "integer", "minimum": 1},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "uri"],
      "properties": {
        "tier": {"const": "semantic"},
        "uri": {"type": "string", "minLength": 1}
      }
    },
    "canonicalAssets": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expression"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "expression": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "verified", "deprecated"]
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      }
    }
  }
}
